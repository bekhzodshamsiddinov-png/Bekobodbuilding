# Copy to .env.local (never commit it). In Vercel: Project → Settings → Environment Variables.

# --- Public (shipped to the browser; safe by design) ---
NEXT_PUBLIC_SITE_URL=https://bekobodbuilding.vercel.app
# Supabase → Project Settings → API. Without these the site runs on built-in sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Big media (video, renders). Default: Webuy GitHub Pages. Later: Cloudflare R2 public bucket URL.
NEXT_PUBLIC_MEDIA_URL=https://bekhzodshamsiddinov-png.github.io/Webuy/assets
# Sales office (shown on the site)
NEXT_PUBLIC_SALES_PHONE=
NEXT_PUBLIC_SALES_ADDRESS=
# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# --- Server only (secrets) ---
PROJECT_SLUG=sadaf-residence
# @BotFather token and the sales group chat id (send /id to the bot after setting the webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Needed only from phase 3 (CRM admin tasks). Never expose to the browser.
SUPABASE_SECRET_KEY=
